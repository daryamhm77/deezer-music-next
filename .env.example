# Local: copy to `.env.local`
# Vercel: Project → Settings → Environment Variables (see env.md)

# --- Required (Production + Preview + Development) ---

# openssl rand -base64 32  (min 32 chars)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# MongoDB
# Local:  mongodb://127.0.0.1:27018
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB_NAME=sea-music-player

# --- Required on Production (Preview uses VERCEL_URL automatically) ---

# Public origin, no trailing slash.
# Local:  http://localhost:3000
# Prod:   https://your-app.vercel.app  (or custom domain)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: Google OAuth ---

# Set all three when enabling Google sign-in.
# Redirect URI (add in Google Cloud Console):
#   Local: http://localhost:3000/api/auth/callback/google
#   Prod:  https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Deezer catalog API is public — no API key required
